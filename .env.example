# Copy this file to .env and fill in your own values. Never commit .env.

# CoinGecko (free Demo plan key: https://www.coingecko.com/en/api)
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=your_demo_api_key

# PostgreSQL. On your Mac the database is on port 5433 (see docker-compose.yml);
# inside Docker the services use postgres:5432 automatically.
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5433
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=change_me
POSTGRESQL_DB=RiskCoin

# Schema Registry. Inside Docker the services use schema-registry:8081.
SCHEMA_REGISTRY_URL=http://localhost:8081
# Which topic the consumer reads when you run it on your Mac: json or avro.
# (The Docker consumer is set to avro in docker-compose.yml.)
EVENT_FORMAT=json

# Object storage for the Iceberg lakehouse (RustFS in Docker). The secret needs at least
# 8 characters. Inside Docker the services use http://lake:9000 automatically.
S3_ACCESS_KEY=riskcoin
S3_SECRET_KEY=change-me-lake-secret
S3_ENDPOINT=http://localhost:9000
LAKE_BUCKET=riskcoin-lake
