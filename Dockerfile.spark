FROM apache/spark:4.0.4-scala2.13-java17-python3-ubuntu

USER root
COPY requirements-spark.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements-spark.txt \
    && mkdir -p /opt/spark/work-dir/checkpoints /opt/spark/work-dir/.ivy2.5.2 \
    && chown -R spark:spark /opt/spark/work-dir

ENV HOME=/opt/spark/work-dir \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/opt/spark/python:/opt/spark/python/lib/py4j-0.10.9.9-src.zip \
    SPARK_CHECKPOINT_DIR=/opt/spark/work-dir/checkpoints/spark_bars \
    PYSPARK_SUBMIT_ARGS="--conf spark.jars.ivy=/opt/spark/work-dir/.ivy2.5.2 pyspark-shell"

WORKDIR /app
COPY src/ src/
USER spark

ENTRYPOINT []
CMD ["python3", "-m", "src.streaming.spark_bars"]
